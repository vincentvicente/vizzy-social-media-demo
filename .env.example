# ─────────────────────────────────────────────────────────────────────────
# vizzy-social-demo — one app, three platforms (Instagram / TikTok / YouTube)
# Copy to .env and fill in. Do NOT commit .env (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────
#
# All three OAuth callbacks must live on ONE public HTTPS origin (this app's
# deployed URL). Set the three *_REDIRECT_ORIGIN values below to the SAME URL —
# your stable Vercel domain, e.g.  https://vizzy-social-demo.vercel.app
# (use a fixed production/alias domain, not a per-commit preview URL, so the
# registered callbacks stay valid across deploys).
#
# Register each platform's callback in its developer console:
#   <origin>/api/instagram/auth/callback
#   <origin>/api/tiktok/auth/callback
#   <origin>/api/youtube/auth/callback

# ─── Shared session encryption ───────────────────────────────────────────
# 32+ char random secret; derives the AES-256-GCM key for ALL session cookies.
# Rotate to invalidate every signed-in user. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ─── Instagram (Meta) — Instagram Login with Business ─────────────────────
# Meta Developer Console → your app → Instagram → API setup with Instagram
# login. Use the "Instagram App ID / Secret", NOT the Facebook App ID/Secret.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_ORIGIN=

# ─── TikTok — Login Kit (Sandbox) ─────────────────────────────────────────
# developers.tiktok.com → your app → Sandbox → App details → Credentials.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_ORIGIN=

# ─── YouTube (Google) — OAuth 2.0 + Data/Analytics API ────────────────────
# Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key for unauthenticated public data calls (YouTube "Path A").
YOUTUBE_API_KEY=
GOOGLE_REDIRECT_ORIGIN=

# ─── Onboarding deep links (PUBLIC — surfaced in the in-app guides) ───────
# The exact developer-console URLs the in-app guide links to, so testers with
# console access can add themselves. Copy each from your browser while on the
# relevant page. Left blank, the guide falls back to the generic console home.
#   TikTok:    your app → Sandbox → "Target users" management page
#   Instagram: Meta app dashboard → App roles → Roles (add Instagram testers)
#   YouTube:   Google Cloud → APIs & Services → OAuth consent screen
#              (the page containing the "Test users" section)
PUBLIC_TIKTOK_SANDBOX_URL=
PUBLIC_INSTAGRAM_TESTERS_URL=
PUBLIC_YOUTUBE_TESTERS_URL=
